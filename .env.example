# Where `npm run dev` proxies /v1 and /healthz (see vite.config.js). Must include http://
# Default: the API port-forwarded with `kubectl port-forward svc/jobbed-api 8080:8080`.
VITE_PROXY_TARGET=http://localhost:8080

# Alternatives for the target:
# - minikube service jobbed-api-nodeport --url   (docker driver on macOS:
#   keep that terminal open; the port changes every run)
# - http://$(minikube ip):30080                     (Linux / VM drivers)
