# Vite dev-server proxy target (see vite.config.js). Must include http://
VITE_PROXY_TARGET=http://localhost:8080

# --- Running the backend on Minikube? Get its URL: ---
#   minikube service <service> -n <namespace> --url   # prints the URL only
#   minikube service list                             # URLs for all services
# Then set VITE_PROXY_TARGET to the printed URL, e.g. http://127.0.0.1:52341
#
# Notes:
# - The service must be NodePort or LoadBalancer (ClusterIP has no external URL):
#     kubectl expose deploy/<name> --type=NodePort --port=<port>
# - Docker driver on macOS: the command opens a tunnel, so keep that terminal
#   open; the port is random and changes each run.
# - Alternative: kubectl port-forward svc/<service> 8080:<port>
#   and keep VITE_PROXY_TARGET=http://localhost:8080
# - LoadBalancer: run `minikube tunnel` in another terminal, then read
#   EXTERNAL-IP from `kubectl get svc`.
# - Ingress: minikube addons enable ingress, then map the host to
#   $(minikube ip) (or 127.0.0.1 with tunnel) in /etc/hosts.
